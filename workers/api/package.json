{
  "name": "inventory-reservation-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "npm run typecheck",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "wrangler d1 migrations apply inventory-reservation-db --remote",
    "migrate:local": "wrangler d1 migrations apply inventory-reservation-db --local",
    "seed": "wrangler d1 execute inventory-reservation-db --local --file=./migrations/0002_seed_data.sql",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "hono": "^4.7.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.0",
    "@cloudflare/workers-types": "^4.20250601.0",
    "typescript": "^5.8.0",
    "vitest": "~3.1.0",
    "wrangler": "^4.0.0"
  }
}
